# PostgreSQL - must match docker-compose.yml settings
POSTGRES_USER=silo_user
POSTGRES_PASSWORD=silo_pass
POSTGRES_DB=silo_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql://silo_user:silo_pass@db:5432/silo_db

# AI Services
AI_VISION_URL=http://localhost:8001
AI_PREDICTIVE_URL=http://localhost:8002
AI_SOIL_URL=http://localhost:8003

# AI Chatbot (Ollama)
# For local development: http://localhost:11434
# For Docker: http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
# Model name - change this to match your local Ollama model
OLLAMA_MODEL=gemma2:9b-instruct-q4_K_M

# Storage
# Windows example: UPLOADS_DIR=C:\Users\yourname\Silo\uploads
# Linux/Mac example: UPLOADS_DIR=/home/yourname/projects/Silo/uploads
UPLOADS_DIR=./uploads

# Notifications — WhatsApp (Twilio) & Telegram. All optional: if unset, the
# alert websocket/FCM push flow still works, only these channels are skipped.
# Telegram: create a bot via @BotFather to get the token; recipients get their
# personal/group chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
# Twilio WhatsApp Sandbox: console.twilio.com -> Messaging -> Try it out -> WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default is usually +14155238886 — confirm in your Twilio console
TWILIO_WHATSAPP_FROM=
